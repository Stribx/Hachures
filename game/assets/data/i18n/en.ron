    // species
    "species.chaineur": "Chainman",
    "species.chaineur.text": "The Chancellery's surveyor: follows the driest road to the Cible.",
    "species.convoi": "Convoy",
    "species.convoi.text": "Hesse's convoy, to escort to the Sortie. Each cart that leaves keeps a Name.",
    "species.echassier": "Stilt-walker",
    "species.echassier.text": "A conscript on stilts: mud and fords don't stop him, brambles do.",
    "species.etayeur": "Imperial Étayeur",
    "species.etayeur.text": "Armoured, it reads l'Ombre and mends the bornes the towers have damaged. Never a scraped one.",
    "species.fuyard": "Fugitive",
    "species.fuyard.text": "Fleeing the Empire. Brought to the Refuge, he brings back a Name.",
    "species.gens_du_col": "Pass Folk",
    "species.gens_du_col.text": "Pressed mountain folk: they climb Roc and run on ice.",
    "species.grande_chaine": "The Great Chain",
    "species.grande_chaine.text": "Gast's cart, drawn by two oxen; its chain plants bornes.",
    "species.grande_chaine_rompue": "The Great Chain, broken",
    "species.grande_chaine_rompue.text": "La Grande Chaîne broken: the oxen panic and flee the towers.",
    "species.harde": "Herd",
    "species.harde.text": "Beasts driven by fear: walls don't steer them, towers do.",
    "species.jalonneur": "Marker",
    "species.jalonneur.text": "Fast and fragile, he runs to steal the Borne-Mère.",
    "species.jalonneur_galeries": "Gallery Jalonneur",
    "species.jalonneur_galeries.text": "It reads le But, and down here the goal is the Puits d'Air.",
    "species.taupier": "Taupier",
    "species.taupier.text": "A gallery miner: rock and fallen stone are easy going, and it passes under barricades.",
    "species.theodolite": "The Frost Theodolite",
    "species.theodolite.text": "Ombeline Sarre's tower on runners: its lens freezes the water in its axis, its masts call the Jalonneurs.",
    "species.theodolite_enlise": "The Theodolite, sinking",
    "species.theodolite_enlise.text": "Its lens cracked, the tower sinks into the thaw. The Lanterne shows the crack.",
