    "species.sablier.text": "It reads the Slope and runs over dunes.",
    "species.caravanier": "Bitter Caravaner",
    "species.caravanier.text": "It reads the Goal and seeks the wells.",
    "species.meridien": "The Meridian",
    "species.meridien.text": "A straight column bent only by the Heliograph.",
    "species.meridien_midi": "The Meridian at Noon",
    "species.meridien_midi.text": "Blinded, it reads Shadow.",
    "species.meridien_trace": "The Meridian Traced",
    "species.meridien_trace.text": "Behind it, the cadastre cuts the map.",
    "choice.4-2.prompt": "Should the kept plan open a hidden gallery?",
    "choice.4-2.garder": "Keep the plan: a source of thieves will open.",
    "choice.4-2.bruler": "Burn the plan: the galleries will stay silent.",
    "note.4-1.sand": "Sand does not let itself be measured twice.",
    "note.4-1.wells": "The wells are goals, not refuges.",
    "note.4-1.hold": "The Salt Pans hold beneath the ink.",
    "note.4-2.plan": "The old plan sleeps beneath the dune.",
    "note.4-2.open": "A gallery opens in the sand.",
    "note.4-2.choice": "Nève's line will have a price.",
    "note.4-3.wind": "The wind pushes every hachure east.",
    "note.4-3.turn": "The wind turns. The map does not forgive.",
    "note.4-3.line": "Both clans finally see the same border.",
    "note.4-4.meridien": "The gnomon walks straight behind Ascelin.",
    "note.4-4.midi": "At noon, it reads fear rather than ground.",
    "note.4-4.trace": "Every step engraves a border.",
    "note.4-4.gnomon": "Date is now in Nève's hand.",
