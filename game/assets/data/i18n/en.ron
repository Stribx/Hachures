    // tool
    "tool.arbalete": "crossbow",
    "tool.arbalete.text": "The plain tower: quick shots at one target.",
    "tool.barricade": "barricade",
    "tool.barricade.text": "Closes a cell. Le Droit de Passage refuses one that would shut a species in.",
    "tool.boue": "mud",
    "tool.boue.text": "Weighs down dry-footed walkers; the Échassier likes it.",
    "tool.gratter": "scrape",
    "tool.gratter.text": "Scrapes off a borne, or returns Éboulis and Palissade to plain Sol. Never Nève's own ink.",
    "tool.renommer": "rename",
    "tool.renommer.text": "Changes a cell's kind: dry ground becomes Eau, Eau and Gué become Sol, Glace turns back to Eau until Le Gel ends. A named cell loses its name.",
    "tool.biffer": "strike out",
    "tool.biffer.text": "Takes back one of Nève's strokes and returns the cell to what it was. Wet ink gives back all its sepia, dry ink half. A scratched-out name never comes back.",
    "tool.harpon": "harpoon",
    "tool.harpon.text": "Pins its target in place.",
    "tool.lanterne": "lantern",
    "tool.lanterne.text": "Dazzles and slows what it lights.",
    "tool.mortier": "mortar",
    "tool.mortier.text": "Slow shots whose splash hits a group.",
    "tool.ronces": "brambles",
    "tool.ronces.text": "A thicket that costs almost everyone dear.",
    "tool.sonde": "probe",
    "tool.sonde.text": "A drill rod on a tripod: it strikes under the ground, where the Taupiers dig.",
