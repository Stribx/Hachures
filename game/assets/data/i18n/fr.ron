    // note
    "note.0-0.dix_ans_plus_tot": "Dix ans plus tôt. La Chancellerie m'a demandé de simplifier cette vallée.",
    "note.0-0.me_souviens_plus_nom": "Je ne me souviens plus du nom. C'est ça, le prix.",
    "note.0-0.route_passe_par_village": "La route passe par le village. Un trait, et elle n'y passe plus.",
    "note.1-1.crue_deux_cartes_tirent": "La crue. Deux cartes tirent ce gué chacune de son côté, et c'est l'eau qui tranche.",
    "note.1-1.hachures_frissonnent_bord_bief": "Les hachures frissonnent au bord du bief. La prochaine fois, la terre hésitera.",
    "note.1-1.oudine_gue_appelle_gue": "Oudine : « Le gué ne s'appelle pas \"gué\". Il s'appelle comme celles qui l'ont passé avec un enfant sur la hanche. »",
    "note.1-1.suivent_route_plus_seche": "Ils suivent la route la plus sèche. Toujours. C'est moi qui le leur ai appris.",
    "note.1-2.crue_encore_echassiers_rient": "La crue encore. Les Échassiers rient dans l'eau.",
    "note.1-2.gens_bocage_leurs_vaches": "Des gens du bocage, leurs vaches devant. Ils cherchent le Refuge. Chacun porte un nom.",
    "note.1-2.jalonneurs_regardent_pente_regardent": "Les Jalonneurs ne regardent pas la pente. Ils regardent la Borne-Mère.",
    "note.1-2.nom_plus_dans_role": "Un nom de plus dans le Rôle d'Oudine.",
    "note.1-3.echassier_fredonne_connais_cet": "Un Échassier fredonne. Je connais cet air : la berceuse d'Oudine.",
    "note.1-3.oudine_ce_champ_appelle": "Oudine : « Ce champ s'appelle Pain-Perdu parce qu'on l'a perdu deux fois. Mets-le sur ta carte, ou je te le répète jusqu'à l'hiver. »",
    "note.1-3.role_grave_reste_savoir": "Le Rôle est gravé. Reste à savoir où mettre ceux qui fuient.",
    "note.1-4.boeufs_paniquent_fuit_tours": "Les bœufs paniquent. Elle fuit les tours : on peut la rabattre.",
    "note.1-4.garde_ma_facon_faire": "Il a gardé ma façon de faire les V.",
    "note.1-4.gast_borne_quatre_plantez": "Gast : « Borne quatre ! Plantez ! Le reste suivra. »",
    "note.1-4.grande_chaine_effondre_dans": "La Grande Chaîne s'effondre dans le bief. Dans ses coffres, un ordre de marche vers les Cols, signé « C. Vass ».",
    "note.1-4.grande_chaine_suit_leve": "La Grande Chaîne suit un levé. Le mien, dix ans plus tôt, borne pour borne.",
    "note.1-4.ma_main_borne_dix": "C'est ma main sur la borne. Dix ans, et l'encre n'a pas pâli.",
    "note.1-4.moulin_decouvert_empire_grave": "Le Moulin est à découvert. L'Empire grave sa propre borne sur la meule : un Nom s'efface du Rôle.",
    "note.1-4.oudine_se_tait_dit": "Oudine se tait. Elle ne dit plus rien du Rôle.",
    "note.1-4.oudine_vu_passer_chacun": "Oudine a vu passer chacun d'eux. Elle parlera, plus tard.",
    "note.2-1.gel_lac_devient_route": "Le Gel. Le lac devient une route, et ce ne sont pas les nôtres qui l'empruntent.",
    "note.2-1.gens_col_grimpent_ce": "Les Gens du Col grimpent ce que les Chaîneurs contournent. Deux lectures pour une même pente.",
    "note.2-1.givre_court_lac_demain": "Le givre court sur le lac. Demain, il portera.",
    "note.2-1.hardes_lisent_pente_elles": "Les Hardes ne lisent pas la pente. Elles lisent mes tours, et passent où je ne regarde pas.",
    "note.2-1.hesse_tu_veux_savoir": "Hesse : « Tu veux savoir qui est l'ennemi ? Regarde qui a froid aux pieds dans les deux colonnes. »",
    "note.2-1.refuge_tient_hesse_compte": "Le Refuge tient. Hesse compte ses gens, puis les miens, et ne dit rien.",
    "note.2-2.avalanche_couloir_sud_existe": "L'avalanche. Le couloir sud n'existe plus que sur ma carte.",
    "note.2-2.corentin_donne_moi_retire": "Corentin : « Donne-les-moi et je retire la 4e. C'est de l'arithmétique, Nève. »",
    "note.2-2.corniche_tient_deux_couloirs": "La corniche tient à deux couloirs. Le sud est plus court, et la neige le sait.",
    "note.2-2.gel_encore_gens_col": "Le Gel encore. Les Gens du Col passent sur le lac sans même baisser les yeux.",
    "note.2-2.neige_pend_dessus_couloir": "La neige pend au-dessus du couloir sud. Je ne trace plus rien dessous.",
    "note.2-2.tout_arithmetique_ca_probleme": "Tout est de l'arithmétique. C'est ça le problème.",
    "note.2-3.charrette_passe_col_hesse": "Une charrette passe le col. Hesse ne se retourne pas.",
    "note.2-3.convoi_passe_sous_glace": "Le convoi est passé. Sous la glace fondue, des hachures que personne n'a tracées.",
    "note.2-3.deux_routes_se_croisent": "Deux routes se croisent au milieu du col : la leur et la sienne. Je n'en trace qu'une à la fois.",
    "note.2-3.gel_convoi_pourrait_couper": "Le Gel. Le convoi pourrait couper par le lac. Les Hardes aussi.",
    "note.2-3.hesse_m_regardee_compte": "Hesse ne m'a pas regardée. Elle a compté ses charrettes, deux fois, et rayé un nom de son registre.",
    "note.2-3.hesse_passe_gens_passe": "Hesse : « Je ne passe pas des gens. Je passe des histoires qui ont encore des jambes. »",
    "note.2-4.chanceliere_attend_combes": "Ombeline : « La Chancelière vous attend dans les Combes. Elle veut vous montrer quelque chose que vous avez signé. »",
    "note.2-4.corentin_parole_legion": "Corentin a tenu parole : une légion de moins. Ombeline n'est pas de ses légions.",
    "note.2-4.deserteurs_passes_sarre": "Les déserteurs sont passés. Ombeline, elle, ne laisse rien passer qu'elle n'a pas mesuré.",
    "note.2-4.deux_mats_trois_points": "Deux mâts et la tour : trois points. S'ils tiennent une vague, le col est à elle.",
    "note.2-4.gel_lac_route_tous": "Le Gel. Le lac devient une route, et une route sert à tout le monde.",
    "note.2-4.lentille_chante_ligne_gele": "La lentille chante. Dans son axe, le lac gèle en ligne droite : une route à elle.",
    "note.2-4.lentille_fele_tour_enlise": "La lentille s'est fêlée. Elle chauffe, la glace cède, la tour s'enlise. La Lanterne montre la fêlure.",
    "note.2-4.rien_signe_dessine": "Je n'ai rien signé. J'ai dessiné. C'est peut-être pire.",
    "note.2-4.trois_points_tenir_montagne": "Ombeline Sarre : « Trois points suffisent à tenir une montagne. »",
    "note.3-1.pellan_carte_cire": "Pellan : « Ta carte sent la cire neuve. Les anciennes sentaient la sueur. »",
    "note.3-1.taupiers_sous_barricades": "Les Taupiers passent sous les barricades. La terre a ses propres portes.",
    "note.3-1.fissures_rouges": "Des fissures rouges courent dans les hachures. Le plateau va céder.",
    "note.3-1.puits_air_tient": "Le Puits d'Air tient. Les étayeurs respirent encore.",
    "note.3-2.pellan_lumiere_tombe": "Pellan baisse la lampe. Le silence devient plus grand que la galerie.",
    "note.3-2.calque_seul": "La lumière tombe. Seul le Calque montre encore les colonnes.",
    "note.3-2.galerie_respire": "La galerie respire par le Puits d'Air. Chaque gouffre a son souffle.",
    "note.3-2.ombre_ne_cache_pas_tout": "L'ombre ne cache pas tout. Elle choisit ce que je refuse de voir.",
    "note.3-3.pellan_carte_sue": "Pellan : « Les anciennes cartes sentaient la sueur, pas la cire. »",
    "note.3-3.neve_plume": "Je reconnais la plume avant de reconnaître la phrase.",
    "note.3-3.plan_garde": "Je garde le plan. Les galeries cachées auront une seconde chance.",
    "note.3-3.plan_brule": "Le plan brûle. Il ne reste de mon village qu'une odeur de suie.",
    "note.3-4.foreuse_sous_terre": "La Foreuse ne marche pas. Elle confirme le sol sous nos pieds.",
    "note.3-4.freres_tarriere": "Un frère Tarrière : « On ne creuse pas, madame. » L'autre : « On confirme. »",
    "note.3-4.meche_exposee": "La mèche sort à l'air. Pour la première fois, la machine a quelque chose à perdre.",
    "note.3-4.plan_originel": "Dans les coffres, le plan originel des Marches porte ma signature.",
