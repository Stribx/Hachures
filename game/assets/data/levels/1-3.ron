// Monde 1, niveau 1-3 (docs, section 6): hold the Moulin des Noms while Oudine engraves the Rôle.
// Unlocks the harpon. Ends with the choice of the Refuge (docs), which shapes the boss level, 1-4.
// Map legend: see 1-1.ron.
(
    world: 1,
    // Where the sheet lies on the Marches: world position of its cell (0, 0) (`overworld`).
    at: (76.0, -20.0),
    name: "level.1-3.name",
    sepia: 120,
    tools: ["barricade", "boue", "ronces", "arbalète", "mortier", "harpon"],
    events: [5, 9],
    challenge: Some((text: "level.1-3.challenge", rule: KeepRole(10))),
    // Notes: see 1-1.ron. Oudine's line and the lullaby (wave 9) are from the docs.
    notes: [
        (on: Start, text: "note.1-3.oudine_ce_champ_appelle"),
        (on: Wave(9), text: "note.1-3.echassier_fredonne_connais_cet"),
        (on: Won, text: "note.1-3.role_grave_reste_savoir"),
    ],
    choice: Some((
        id: "refuge",
        prompt: "choice.refuge.prompt",
        options: [
            ("moulin", "choice.refuge.moulin"),
            ("bois", "choice.refuge.bois"),
        ],
    )),
    // Named places: inking any of their cells scratches the name out of the Rôle (docs, section 2). Drafts.
    places: [
        (name: "place.pont_du_bief", at: [(9, 4), (9, 5)]),
        (name: "place.pres_oudine", at: [(11, 2), (12, 2), (13, 2), (11, 3), (12, 3), (13, 3)]),
        (name: "place.clos_gaillard", at: [(2, 6), (3, 6), (4, 6), (2, 7), (3, 7), (4, 7)]),
    ],
    map: [
        "^^^^^^^^^^^^^^^^^^",
        "S......rr........F",
        ".......rr..,,,....",
        "..bb.......,,,..rr",
        "~~~~~g~~~.~~~~g~~~",
        "~~~~~g~~~.~~~~g~~~",
        "..,,,.............",
        "..,,,..rr..B...R..",
        ".......rr.......M.",
        "^^^^^^^^^^^^^^^^^^",
    ],
    waves: [
        [("chaineur", 8), ("jalonneur", 2)],
        [("chaineur", 6), ("echassier", 4)],
        [("jalonneur", 6), ("chaineur", 6), ("fuyard", 3)],
        [("chaineur", 10), ("echassier", 4)],
        [("echassier", 8), ("chaineur", 6), ("fuyard", 4)],
        [("chaineur", 10), ("jalonneur", 6)],
        [("chaineur", 12), ("echassier", 6), ("fuyard", 4)],
        [("jalonneur", 10), ("chaineur", 8)],
        // Docs: an Échassier hums Oudine's lullaby here (a margin note until there is a sound).
        [("echassier", 10), ("chaineur", 10), ("fuyard", 4)],
        [("chaineur", 14), ("jalonneur", 8)],
        [("chaineur", 14), ("echassier", 8), ("jalonneur", 6), ("fuyard", 5)],
        [("chaineur", 16), ("echassier", 8), ("jalonneur", 8)],
    ],
)
