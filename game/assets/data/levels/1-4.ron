// Monde 1, boss (docs, section 6): La Grande Chaîne, commanded by Gast, comes for the Moulin des Noms.
// The Refuge stands where 1-3's choice put it: `R` beside the Moulin, or `W` in the Bois.
// Map legend: see 1-1.ron.
(
    world: 1,
    // Where the sheet lies on the Marches: world position of its cell (0, 0) (`overworld`).
    at: (102.0, -8.0),
    name: "level.1-4.name",
    sepia: 120,
    tools: ["barricade", "boue", "ronces", "arbalète", "mortier", "harpon"],
    // Winning the boss earns Gratter for good: it joins every level's tools.
    grants: ["gratter"],
    events: [4],
    alt_refuge: Some("refuge=bois"),
    // Notes: see 1-1.ron. Gast's line, the twist, Nève's borne line, the Bois consequence
    // and the closing transition are from the docs; the others are drafts.
    notes: [
        (on: Start, text: "note.1-4.gast_borne_quatre_plantez"),
        (on: Boss("boss.grande_chaine.leve"), text: "note.1-4.grande_chaine_suit_leve"),
        (on: Boss("boss.grande_chaine.bornage"), text: "note.1-4.ma_main_borne_dix"),
        (
            on: Boss("boss.grande_chaine.bornage"),
            when: Some("refuge=bois"),
            text: "note.1-4.moulin_decouvert_empire_grave",
            names: -1,
        ),
        (on: Boss("boss.grande_chaine.chaine_rompue"), text: "note.1-4.boeufs_paniquent_fuit_tours"),
        (on: Won, text: "note.1-4.grande_chaine_effondre_dans"),
        (on: Won, text: "note.1-4.garde_ma_facon_faire"),
        (on: Won, when: Some("refuge=moulin"), text: "note.1-4.oudine_vu_passer_chacun"),
        (on: Won, when: Some("refuge=bois"), text: "note.1-4.oudine_se_tait_dit"),
    ],
    // Named places: inking any of their cells scratches the name out of the Rôle (docs, section 2). Drafts.
    places: [
        (name: "place.pont_du_bief", at: [(9, 4), (9, 5)]),
        (name: "place.pres_oudine", at: [(11, 2), (12, 2), (13, 2), (11, 3), (12, 3), (13, 3)]),
        (name: "place.clos_gaillard", at: [(2, 6), (3, 6), (4, 6), (2, 7), (3, 7), (4, 7)]),
    ],
    map: [
        "^^^^^^^^^^^^^^^^^^",
        "S......rr........F",
        ".......rr..,,,....",
        "..bb.......,,,..rr",
        "~~~~~g~~~.~~~~g~~~",
        "~~~~~g~~~.~~~~g~~~",
        "W.,,,.............",
        "..,,,..rr..B......",
        ".......rr......RM.",
        "^^^^^^^^^^^^^^^^^^",
    ],
    waves: [
        [("chaineur", 8), ("fuyard", 3)],
        [("jalonneur", 6), ("chaineur", 6)],
        [("echassier", 6), ("chaineur", 6), ("fuyard", 4)],
        [("chaineur", 10), ("jalonneur", 6)],
        [("echassier", 8), ("chaineur", 8), ("fuyard", 4)],
        [("chaineur", 12), ("jalonneur", 8)],
        [("chaineur", 12), ("echassier", 8), ("fuyard", 5)],
        [("grande_chaine", 1), ("jalonneur", 8), ("chaineur", 10), ("fuyard", 4)],
    ],
)
