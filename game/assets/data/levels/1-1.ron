// Monde 1, niveau 1-1 (docs, section 6): learn la Pente. Chaîneurs and Échassiers only.
// Map: . sol  , sol bas  b boue  r ronces  ~ eau  g gué  # barricade  ^ roc
//      S spawn  F Fuyards' start  M Moulin  B Borne-Mère  R Refuge
// The bridge (the `.` in the river) stays dry during La Crue; the fords drown.
(
    world: 1,
    // Where the sheet lies on the Marches: world position of its cell (0, 0) (`overworld`).
    at: (24.0, -16.0),
    name: "level.1-1.name",
    sepia: 120,
    tools: ["barricade", "boue", "arbalète"],
    // Docs: first flood at wave 6.
    events: [6, 10],
    challenge: Some((text: "level.1-1.challenge", rule: Without("barricade"))),
    // Every text here is a key of `assets/data/i18n/<code>.ron` (`fr.ron` holds the French).
    // Notes: Nève's notebook in the margin (docs, section 9). Triggers: Start, Wave(n), Event (the world event starts), Boss(phase key),
    // FuyardHurt, FuyardSaved, Won. `when: Some("id=option")` keeps a note to one choice; `names` changes the Rôle.
    notes: [
        // Oudine's line is from the docs; the others are drafts.
        (on: Start, text: "note.1-1.oudine_gue_appelle_gue"),
        (on: Wave(1), text: "note.1-1.suivent_route_plus_seche"),
        (on: Wave(5), text: "note.1-1.hachures_frissonnent_bord_bief"),
        (on: Event, text: "note.1-1.crue_deux_cartes_tirent"),
    ],
    // Named places: inking any of their cells scratches the name out of the Rôle (docs, section 2). Drafts.
    places: [
        (name: "place.pont_aux_lavandieres", at: [(11, 4), (11, 5)]),
        (name: "place.pre_commun", at: [(12, 2), (13, 2), (14, 2), (12, 3), (13, 3), (14, 3)]),
        (name: "place.clos_marthe", at: [(5, 6), (6, 6), (7, 6), (8, 6), (5, 7), (6, 7), (7, 7), (8, 7)]),
    ],
    map: [
        "^^^^^^^^^^^^^^^^^^",
        "S.....rr..........",
        "......rr....,,,...",
        "..bb........,,,...",
        "~~~~~~~g~~~.~~~g~~",
        "~~~~~~~g~~~.~~~g~~",
        ".....,,,,.........",
        ".....,,,,...rr....",
        "...........rr....M",
        "^^^^^^^^^^^^^^^^^^",
    ],
    // One list per wave: (species, count); the groups spawn interleaved.
    waves: [
        [("chaineur", 5)],
        [("chaineur", 7)],
        [("chaineur", 6), ("echassier", 2)],
        [("chaineur", 8), ("echassier", 2)],
        [("echassier", 4), ("chaineur", 6)],
        [("chaineur", 8), ("echassier", 4)],
        [("chaineur", 10), ("echassier", 3)],
        [("echassier", 6), ("chaineur", 8)],
        [("chaineur", 10), ("echassier", 3)],
        [("chaineur", 8), ("echassier", 5)],
        [("chaineur", 11), ("echassier", 4)],
        [("chaineur", 10), ("echassier", 6)],
    ],
)
