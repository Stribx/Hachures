    world: 1,
    name: "1-2 · Les Haies de Pain-Perdu",
    sepia: 120,
    tools: ["barricade", "boue", "ronces", "arbalète", "mortier"],
    events: [7, 11],
    challenge: Some((text: "Aucun Fuyard blessé", rule: NoFuyardHurt)),
    // Notes: see 1-1.ron. Drafts, except the wave 4 Fuyards, which are in the docs.
    notes: [
        (on: Start, text: "Les Jalonneurs ne regardent pas la pente. Ils regardent la Borne-Mère."),
        (on: Wave(4), text: "Des gens du bocage, leurs vaches devant. Ils cherchent le Refuge. Chacun porte un nom."),
        (on: FuyardSaved, text: "Un nom de plus dans le Rôle d'Oudine."),
        (on: FuyardHurt, text: "Le mortier ne fait pas la différence entre un sceau et un tablier."),
        (on: Event, text: "La crue encore. Les Échassiers rient dans l'eau."),
