// Monde 2, niveau 2-3 (docs, section 6): the escort. Hesse's convoy crosses the col to the Sortie [S]
// while the legions climb to the Refuge Sarre. Keep the carts a short, safe road: towers never aim at
// them, but a mortar shell does not ask whose cart it is.
// Map: . sol  ~ eau  ^ roc   S spawn  M the Refuge Sarre (the Cible)  F the convoy's start  X the Sortie
// The deserters choice of 2-2: escorted, the level is full; handed over, it drops its last two waves.
(
    world: 2,
    name: "2-3 · Le Passage de Hesse",
    // Above the docs' 120: world 2 HP is ×1.5 for the same loot (set with the balance bot).
    sepia: 180,
    tools: ["barricade", "boue", "ronces", "arbalète", "mortier", "harpon", "lanterne"],
    // Le Gel lasts two waves: 5-6 and 9-10.
    events: [5, 9],
    shorter: Some(("deserteurs=livrer", 2)),
    challenge: Some((text: "Aucune charrette du convoi blessée", rule: NoFuyardHurt)),
    notes: [
        // Hesse's line is from the docs; the others are drafts.
        (on: Start, when: Some("deserteurs=escorter"), text: "Hesse : « Je ne passe pas des gens. Je passe des histoires qui ont encore des jambes. »"),
        // Handing the deserters over costs the world's Name: Hesse will not come back.
        (on: Start, when: Some("deserteurs=livrer"), names: -1, text: "Hesse ne m'a pas regardée. Elle a compté ses charrettes, deux fois, et rayé un nom de son registre."),
        (on: Wave(1), text: "Deux routes se croisent au milieu du col : la leur et la sienne. Je n'en trace qu'une à la fois."),
        (on: Event, text: "Le Gel. Le convoi pourrait couper par le lac. Les Hardes aussi."),
        (on: FuyardHurt, text: "Le mortier ne lit pas les passeports. Hesse non plus ne me le pardonnera pas."),
        (on: FuyardSaved, text: "Une charrette passe le col. Hesse ne se retourne pas."),
        (on: Won, text: "Le convoi est passé. Sous la glace fondue, des hachures que personne n'a tracées."),
    ],
    map: [
        "^^^^^^^^^^^^^^^^^^",
        "^.......^^.......X",
        "^.~~~~..^^..~~~..^",
        "S.~~~~..........M^",
        "^.~~~~......~~~..^",
        "^.......^^.......^",
        "F.......^^.......^",
        "^^^^^^^^^^^^^^^^^^",
    ],
    waves: [
        [("chaineur", 4), ("convoi", 2)],
        [("gens_du_col", 3), ("chaineur", 3)],
        [("harde", 2), ("chaineur", 4), ("convoi", 2)],
        [("gens_du_col", 4), ("chaineur", 3)],
        [("harde", 2), ("gens_du_col", 3), ("convoi", 3)],
        [("chaineur", 6), ("harde", 2)],
        [("gens_du_col", 5), ("chaineur", 4), ("convoi", 3)],
        [("harde", 3), ("chaineur", 5)],
        [("gens_du_col", 5), ("harde", 2), ("convoi", 3)],
        [("gens_du_col", 5), ("chaineur", 5)],
        [("harde", 3), ("chaineur", 6), ("convoi", 3)],
        [("gens_du_col", 5), ("harde", 3), ("chaineur", 5), ("convoi", 4)],
    ],
)
