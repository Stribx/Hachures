// Monde 2, niveau 2-2 (docs, section 6): wave 7, an avalanche blocks a corridor [T].
// Map: . sol  ~ eau  r ronces  ^ roc   S spawn  M the Refuge Sarre (the Cible)
// A spine of rock splits the col into a north and a south corridor. The avalanche closes the south one:
// le Droit de Passage counts it from the start, so the north corridor can never be inked shut.
// Ends with the choice about the deserters hidden in Hesse's convoy, which shapes 2-3.
(
    world: 2,
    // Where the sheet lies on the Marches: world position of its cell (0, 0) (`overworld`).
    at: (164.0, -12.0),
    name: "level.2-2.name",
    // Above the docs' 120: world 2 HP is ×1.5 for the same loot (set with the balance bot).
    sepia: 180,
    tools: ["barricade", "boue", "ronces", "arbalète", "mortier", "harpon", "lanterne"],
    // Le Gel lasts two waves: 4-5 and 10-11.
    events: [4, 10],
    changes: [
        // The avalanche: the south corridor turns to rock.
        (wave: 7, at: [(10, 6), (11, 6)], becomes: Roc),
    ],
    challenge: Some((text: "level.2-2.challenge", rule: KeepNames)),
    notes: [
        // Corentin's and Nève's lines are from the docs; the others are drafts.
        (on: Start, text: "note.2-2.corniche_tient_deux_couloirs"),
        (on: Wave(6), text: "note.2-2.neige_pend_dessus_couloir"),
        (on: Wave(7), text: "note.2-2.avalanche_couloir_sud_existe"),
        (on: Event, text: "note.2-2.gel_encore_gens_col"),
        (on: Won, text: "note.2-2.corentin_donne_moi_retire"),
        (on: Won, text: "note.2-2.tout_arithmetique_ca_probleme"),
    ],
    choice: Some((
        id: "deserteurs",
        prompt: "choice.deserteurs.prompt",
        options: [
            ("escorter", "choice.deserteurs.escorter"),
            ("livrer", "choice.deserteurs.livrer"),
        ],
    )),
    // Named places: inking any of their cells scratches the name out of the Rôle (docs, section 2). Drafts.
    places: [
        (name: "place.corniche", at: [(12, 1), (13, 1), (14, 1)]),
        (name: "place.replat_sarre", at: [(13, 3), (14, 3), (13, 4), (14, 4)]),
        (name: "place.pre_des_sonnailles", at: [(3, 6), (4, 6), (5, 6)]),
    ],
    map: [
        "^^^^^^^^^^^^^^^^^^",
        "^................^",
        "^.~~~~~~..^^.....^",
        "S.~~~~~~..^^.....M",
        "^.~~~~~~..^^.....^",
        "^.~~~~~~..^^.....^",
        "^...............r^",
        "^^^^^^^^^^^^^^^^^^",
    ],
    waves: [
        [("chaineur", 4)],
        [("gens_du_col", 3), ("chaineur", 3)],
        [("harde", 2), ("chaineur", 4)],
        [("gens_du_col", 4), ("chaineur", 3)],
        [("harde", 2), ("gens_du_col", 3)],
        [("chaineur", 6), ("harde", 2)],
        [("gens_du_col", 5), ("chaineur", 4)],
        [("harde", 3), ("chaineur", 5)],
        [("gens_du_col", 5), ("harde", 2)],
        [("gens_du_col", 5), ("chaineur", 5)],
        [("harde", 3), ("chaineur", 6)],
        [("gens_du_col", 5), ("harde", 2), ("chaineur", 5)],
    ],
)
