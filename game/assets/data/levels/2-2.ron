// Monde 2, niveau 2-2 (docs, section 6): wave 7, an avalanche blocks a corridor [T].
// Map: . sol  ~ eau  r ronces  ^ roc   S spawn  M the Refuge Sarre (the Cible)
// A spine of rock splits the col into a north and a south corridor. The avalanche closes the south one:
// le Droit de Passage counts it from the start, so the north corridor can never be inked shut.
// Ends with the choice about the deserters hidden in Hesse's convoy, which shapes 2-3.
(
    world: 2,
    name: "2-2 · La Corniche des Convois",
    // Above the docs' 120: world 2 HP is ×1.5 for the same loot (set with the balance bot).
    sepia: 180,
    tools: ["barricade", "boue", "ronces", "arbalète", "mortier", "harpon", "lanterne"],
    // Le Gel lasts two waves: 4-5 and 10-11.
    events: [4, 10],
    changes: [
        // The avalanche: the south corridor turns to rock.
        (wave: 7, at: [(10, 6), (11, 6)], becomes: Roc),
    ],
    challenge: Some((text: "Garder quinze du Rôle", rule: KeepRole(15))),
    notes: [
        // Corentin's and Nève's lines are from the docs; the others are drafts.
        (on: Start, text: "La corniche tient à deux couloirs. Le sud est plus court, et la neige le sait."),
        (on: Wave(6), text: "La neige pend au-dessus du couloir sud. Je ne trace plus rien dessous."),
        (on: Wave(7), text: "L'avalanche. Le couloir sud n'existe plus que sur ma carte."),
        (on: Event, text: "Le Gel encore. Les Gens du Col passent sur le lac sans même baisser les yeux."),
        (on: Won, text: "Corentin : « Donne-les-moi et je retire la 4e. C'est de l'arithmétique, Nève. »"),
        (on: Won, text: "Tout est de l'arithmétique. C'est ça le problème."),
    ],
    choice: Some((
        id: "deserteurs",
        prompt: "Le convoi de Hesse cache des déserteurs échassiers : ceux qui marchaient contre le Moulin. Corentin les réclame.",
        options: [
            ("escorter", "Les escorter avec le convoi : le passage sera plus dur."),
            ("livrer", "Les livrer à Corentin : il retire une légion, deux vagues de moins."),
        ],
    )),
    map: [
        "^^^^^^^^^^^^^^^^^^",
        "^................^",
        "^.~~~~~~..^^.....^",
        "S.~~~~~~..^^.....M",
        "^.~~~~~~..^^.....^",
        "^.~~~~~~..^^.....^",
        "^...............r^",
        "^^^^^^^^^^^^^^^^^^",
    ],
    waves: [
        [("chaineur", 4)],
        [("gens_du_col", 3), ("chaineur", 3)],
        [("harde", 2), ("chaineur", 4)],
        [("gens_du_col", 4), ("chaineur", 3)],
        [("harde", 2), ("gens_du_col", 3)],
        [("chaineur", 6), ("harde", 2)],
        [("gens_du_col", 5), ("chaineur", 4)],
        [("harde", 3), ("chaineur", 5)],
        [("gens_du_col", 5), ("harde", 2)],
        [("gens_du_col", 5), ("chaineur", 5)],
        [("harde", 3), ("chaineur", 6)],
        [("gens_du_col", 5), ("harde", 2), ("chaineur", 5)],
    ],
)
