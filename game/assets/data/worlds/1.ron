// Monde 1 : Les Marches de Saule (docs, section 6). Levels 1-1 to 1-4.
// Fields: `World` and `Event` in `level/world.rs`, the boss's `BossFile` and `Phase` in `combat/boss.rs`.
(
    name: "world.1.name",
    defends: "world.1.defends",
    // La Crue [T]: during a wave, low ground (Sol bas, Gué) turns to water, except under barricades, palissades and towers.
    event: Some((
        cells: [SolBas, Gue],
        becomes: Eau,
        spares: [Barricade, Tour, Palissade],
        lasts: 1,
        announce: "world.1.announce",
        during: "world.1.during",
        refuse_next: "world.1.refuse_next",
        refuse_after: "world.1.refuse_after",
        color: (0.2, 0.4, 0.9),
    )),
    // La Grande Chaîne, commanded by Gast. It spawns when a wave sends the first phase's species;
    // each phase lasts until its HP fraction drops to `until`. HP, speed and loot are in species.ron.
    boss: Some((
        name: "boss.grande_chaine.name",
        // Rôle lost if it reaches the Moulin.
        breach: 5,
        // HP of a borne, relative to the Chaîneur's 100.
        borne_hp: 1.5,
        // It drags its arpentage chain.
        chain: true,
        phases: [
            (
                name: "boss.grande_chaine.leve",
                until: 0.66,
                species: "grande_chaine",
                // Lays Chaussée on every third cell it leaves [T]; three arbalète hits stun it.
                chaussee_every: 3,
                stun_hits: 3,
                stun: 2.0,
            ),
            (
                name: "boss.grande_chaine.bornage",
                until: 0.33,
                species: "grande_chaine",
                // Plants a borne every other cell, three in all: each one draws the Jalonneurs [S].
                bornes: 3,
            ),
            (
                name: "boss.grande_chaine.chaine_rompue",
                until: 0.0,
                // The oxen panic: it reads l'Ombre and flees the towers [P]; a harpoon holds it.
                species: "grande_chaine_rompue",
                pinnable: true,
            ),
        ],
    )),
)
