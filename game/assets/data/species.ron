// Species profiles (docs, section 8: bestiaire).
// `goal`: the Dijkstra source the species walks to (lecture de la Pente -> Moulin, lecture du But -> its own target).
// `reading`: Pente (default) prices tiles with `costs`; Ombre prices every walkable cell 1 + the towers covering it.
// `hp` is relative to the Chaîneur's 100 HP; `speed` in tiles per second on a cost-1 tile (not in the docs: tune here).
// A tile left out of `costs` is impassable for that species; `costs` also set walking speed.
{
    "chaineur": (
        goal: Cible, hostile: true, hp: 1.0, speed: 1.0, loot: 2, weak_to: Some(Arbalete),
        color: (0.55, 0.55, 0.6),
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 3.0, Ronces: 4.0, Gue: 2.0, Chaussee: 0.5, Glace: 2.0},
    ),
    "echassier": (
        goal: Cible, hostile: true, hp: 1.2, speed: 0.9, loot: 3, weak_to: Some(Mortier),
        color: (0.75, 0.45, 0.25),
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 1.0, Ronces: 5.0, Eau: 2.0, Gue: 1.0, Chaussee: 1.0, Glace: 4.0},
    ),
    "jalonneur": (
        goal: BorneMere, hostile: true, hp: 0.7, speed: 1.3, loot: 2, weak_to: Some(Harpon),
        color: (0.7, 0.2, 0.2),
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 3.0, Ronces: 4.0, Gue: 2.0, Chaussee: 0.5, Glace: 2.0},
    ),
    "fuyard": (
        goal: Refuge, hostile: false, hp: 0.5, speed: 1.1, loot: 0, weak_to: None,
        color: (0.95, 0.9, 0.75),
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 2.0, Ronces: 3.0, Gue: 2.0, Chaussee: 1.0},
    ),
    // Monde 2. The Gens du Col climb rock and run on ice.
    "gens_du_col": (
        goal: Cible, hostile: true, hp: 1.3, speed: 1.0, loot: 3, weak_to: Some(Lanterne),
        color: (0.55, 0.65, 0.8),
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 2.0, Ronces: 3.0, Roc: 3.0, Gue: 2.0, Chaussee: 1.0, Glace: 1.0},
    ),
    // Pack beasts that read l'Ombre: 1 + the towers covering a cell. Towers steer them, walls don't.
    "harde": (
        goal: Cible, hostile: true, hp: 2.0, speed: 0.8, loot: 4, weak_to: None, reading: Ombre,
        color: (0.45, 0.35, 0.25),
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 1.0, Ronces: 1.0, Gue: 1.0, Chaussee: 1.0, Glace: 1.0},
    ),
    // Monde 2, 2-3: Hesse's convoy, an ally walking to the Sortie [S]. Towers never aim at it,
    // but a mortar shell hurts it; each cart that leaves the map keeps a Name.
    "convoi": (
        goal: Sortie, hostile: false, hp: 1.0, speed: 0.8, loot: 0, weak_to: None,
        color: (0.85, 0.7, 0.4),
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 2.0, Ronces: 3.0, Gue: 2.0, Chaussee: 1.0, Glace: 2.0},
    ),
    // La Grande Chaîne, the boss of monde 1 (phases in worlds/1.ron). A wagon: slow in brambles,
    // but it can go wherever a Chaîneur can, so it never makes le Droit de Passage stricter.
    "grande_chaine": (
        goal: Cible, hostile: true, hp: 20.0, speed: 0.5, loot: 40, weak_to: None,
        color: (0.2, 0.18, 0.15),
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 3.0, Ronces: 6.0, Gue: 2.0, Chaussee: 0.5},
    ),
    // Phase 3, la Chaîne rompue: the oxen panic and it flees the towers.
    "grande_chaine_rompue": (
        goal: Cible, hostile: true, hp: 20.0, speed: 0.7, loot: 40, weak_to: None, reading: Ombre,
        color: (0.2, 0.18, 0.15),
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 2.0, Ronces: 3.0, Gue: 1.5, Chaussee: 1.0},
    ),
}
