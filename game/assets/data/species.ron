// Species profiles (docs, section 8: bestiaire). Colours must read on the paper board.
// `label`: the species as the player reads it (route, Calque): a key of `assets/data/i18n/<code>.ron`.
// `goal`: the Dijkstra source the species walks to (lecture de la Pente -> Moulin, lecture du But -> its own target).
// `reading`: Pente (default) prices tiles with `costs`; Ombre prices every walkable cell 1 + the towers covering it.
// `shape`: Pied (default), Echasses, Bete or Chariot, the silhouette it is drawn with.
// `carries`: the props its figurine wears (Bicorne, Chaine, Jalon, Paille, Fichu, Ballot, Enfant, Capuche, Corde, Piolet, Bats, Bache, Meneur, Boeufs, Joug, Gast, Visee); none by default.
// `hp` is relative to the Chaîneur's 100 HP; `speed` in tiles per second on a cost-1 tile (not in the docs: tune here).
// A tile left out of `costs` is impassable for that species; `costs` also set walking speed.
{
    "chaineur": (
        label: "species.chaineur",
        goal: Cible, hostile: true, hp: 1.0, speed: 1.0, loot: 2, weak_to: Some(Arbalete),
        color: (0.30, 0.32, 0.40), carries: [Bicorne, Chaine],
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 3.0, Ronces: 4.0, Gue: 2.0, Chaussee: 0.5, Glace: 2.0, Eboulis: 3.0},
    ),
    "echassier": (
        label: "species.echassier",
        goal: Cible, hostile: true, hp: 1.2, speed: 0.9, loot: 3, weak_to: Some(Mortier),
        color: (0.46, 0.4, 0.14), shape: Echasses, carries: [Paille],
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 1.0, Ronces: 5.0, Eau: 2.0, Gue: 1.0, Chaussee: 1.0, Glace: 4.0, Eboulis: 3.0},
    ),
    "jalonneur": (
        label: "species.jalonneur",
        goal: BorneMere, hostile: true, hp: 0.7, speed: 1.3, loot: 2, weak_to: Some(Harpon),
        color: (0.22, 0.22, 0.32), carries: [Bicorne, Jalon],
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 3.0, Ronces: 4.0, Gue: 2.0, Chaussee: 0.5, Glace: 2.0, Eboulis: 3.0},
    ),
    "fuyard": (
        label: "species.fuyard",
        goal: Refuge, hostile: false, hp: 0.5, speed: 1.1, loot: 0, weak_to: None,
        color: (0.24, 0.46, 0.4), carries: [Fichu, Ballot, Enfant],
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 2.0, Ronces: 3.0, Gue: 2.0, Chaussee: 1.0, Eboulis: 3.0},
    ),
    // Monde 2. The Gens du Col climb rock and run on ice.
    "gens_du_col": (
        label: "species.gens_du_col",
        goal: Cible, hostile: true, hp: 1.3, speed: 1.0, loot: 3, weak_to: Some(Lanterne),
        color: (0.3, 0.42, 0.62), carries: [Capuche, Corde, Piolet],
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 2.0, Ronces: 3.0, Roc: 3.0, Gue: 2.0, Chaussee: 1.0, Glace: 1.0, Eboulis: 2.0},
    ),
    // Pack beasts that read l'Ombre: 1 + the towers covering a cell. Towers steer them, walls don't.
    "harde": (
        label: "species.harde",
        goal: Cible, hostile: true, hp: 2.0, speed: 0.8, loot: 4, weak_to: None, reading: Ombre,
        color: (0.45, 0.35, 0.25), shape: Bete, carries: [Bats],
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 1.0, Ronces: 1.0, Gue: 1.0, Chaussee: 1.0, Glace: 1.0, Eboulis: 1.0},
    ),
    // Monde 2, 2-3: Hesse's convoy, an ally walking to the Sortie [S]. Towers never aim at it,
    // but a mortar shell hurts it; each cart that leaves the map keeps a Name.
    "convoi": (
        label: "species.convoi",
        goal: Sortie, hostile: false, hp: 1.0, speed: 0.8, loot: 0, weak_to: None,
        color: (0.24, 0.46, 0.4), shape: Chariot, carries: [Bache, Meneur],
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 2.0, Ronces: 3.0, Gue: 2.0, Chaussee: 1.0, Glace: 2.0, Eboulis: 4.0},
    ),
    // La Grande Chaîne, the boss of monde 1 (phases in worlds/1.ron). A wagon: slow in brambles,
    // but it can go wherever a Chaîneur can, so it never makes le Droit de Passage stricter.
    "grande_chaine": (
        label: "species.grande_chaine",
        goal: Cible, hostile: true, hp: 20.0, speed: 0.5, loot: 40, weak_to: None,
        color: (0.36, 0.24, 0.14), shape: Chariot, carries: [Boeufs, Joug, Gast, Visee],
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 3.0, Ronces: 6.0, Gue: 2.0, Chaussee: 0.5, Eboulis: 3.0},
    ),
    // Phase 3, la Chaîne rompue: the oxen panic and it flees the towers.
    "grande_chaine_rompue": (
        label: "species.grande_chaine_rompue",
        goal: Cible, hostile: true, hp: 20.0, speed: 0.7, loot: 40, weak_to: None, reading: Ombre,
        color: (0.36, 0.24, 0.14), shape: Chariot, carries: [Boeufs, Joug, Gast, Visee],
        costs: {Sol: 1.0, SolBas: 1.0, Boue: 2.0, Ronces: 3.0, Gue: 1.5, Chaussee: 1.0, Eboulis: 2.0},
    ),
}
